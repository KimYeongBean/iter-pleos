<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Iter</string>
    <string name="recording_channel">주행 기록</string>
    <string name="recording_notification_title">주행을 기록하고 있어요</string>
    <string name="recording_notification_text">앱을 열지 않아도 오늘의 그림이 쌓여요</string>
    <string name="background_location_title">앱을 닫아도 경로를 기록할까요?</string>
    <string name="background_location_message">시동을 걸면 앱을 열지 않아도 주행을 기록해요. 위치를 \'항상 허용\'하면 이때도 지도에 경로가 그려지고, 허용하지 않으면 경로 없이 하루 그림만 쌓여요. 위치는 기기 안에만 저장돼요.</string>
    <string name="background_location_allow">설정하기</string>
    <string name="background_location_later">나중에</string>
    <string name="consent_title">주행을 기록하기 전에</string>
    <string name="consent_lead">Iter는 운전한 날을 그림으로 남기려고 차량 신호를 기록해요. 아래 내용을 읽고 동의할지 골라 주세요.</string>
    <string name="consent_items_title">기록하는 항목</string>
    <string name="consent_items">주행 시각, 차속, 기어, 깜빡이·와이퍼·하향등, 조향각, 브레이크 페달. 위치는 아래에서 따로 동의할 때만 기록해요.</string>
    <string name="consent_purpose_title">쓰는 곳</string>
    <string name="consent_purpose">하루 그림과 맵 그래프를 그리는 데만 써요. 광고나 다른 목적에 쓰지 않아요.</string>
    <string name="consent_storage_title">저장과 공유</string>
    <string name="consent_storage">이 기기 안에만 저장해요. 기기 밖으로 보내거나 다른 사람·회사와 공유하지 않아요. 시동을 걸면 앱을 열지 않아도 기록하고, 기록하는 동안 알림이 보여요.</string>
    <string name="consent_retention_title">보관 기간</string>
    <string name="consent_retention">동의를 철회하거나 앱을 지울 때까지 보관해요. 철회하면 저장된 기록을 바로 모두 지워요. 설정 &gt; 개인정보에서 언제든 다시 보거나 철회할 수 있어요.</string>
    <string name="consent_refuse_title">동의하지 않으면</string>
    <string name="consent_refuse">동의하지 않아도 앱을 열 수 있지만 주행은 기록되지 않아요. 위치에만 동의하지 않으면 지도 경로 없이 하루 그림만 쌓여요.</string>
    <string name="consent_location_title">위치도 기록하기 (선택)</string>
    <string name="consent_location_hint">맵 그래프에 그날의 경로를 그려요. 켜지 않으면 위치는 기록하지 않아요.</string>
    <string name="consent_decline">동의 안 함</string>
    <string name="consent_agree">동의하고 시작</string>
    <string name="consent_close">닫기</string>
